{
  "name": "baatcheet-nodejs-backend",
  "version": "1.0.0",
  "description": "Nodejs version of Baatcheet / Its Okay to Talk (IOTT)",
  "main": "app.js",
  "scripts": {
    "prod": "cross-env NODE_ENV=production node ./bin/www",
    "dev": "cross-env NODE_ENV=development node ./bin/www ",
    "test": "cross-env NODE_ENV=test node ./bin/www",
    "local": "cross-env NODE_ENV=local node ./bin/www",
    "mocha": "cross-env NODE_ENV=local mocha --timeout 25000 --colors",
    "test:awesome": "mocha --reporter mochawesome || true",
    "open:report": "open mochawesome-report/mochawesome.html",
    "test:register": "cross-env NODE_ENV=local npx jest tests/user.register.test.js --forceExit --verbose",
    "test:login": "cross-env NODE_ENV=local npx jest tests/user.login.test.js --forceExit --verbose",
    "test:update": "cross-env NODE_ENV=local npx jest tests/user.update.test.js --forceExit --verbose",
    "test:get": "cross-env NODE_ENV=local npx jest tests/user.get.test.js --forceExit --verbose",
    "test:delete": "cross-env NODE_ENV=local npx jest tests/user.delete.test.js --forceExit --verbose",
    "test:language": "cross-env NODE_ENV=local npx jest tests/user.language.test.js --forceExit --verbose",
    "test:story.read": "cross-env NODE_ENV=local npx jest tests/user.story.read.test.js --forceExit --verbose",
    "test:bookmark.add": "cross-env NODE_ENV=local npx jest tests/user.bookmark.add.test.js --forceExit --verbose"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "mysql2": "^3.22.3",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2"
  }
}
